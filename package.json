{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check --minimumSeverity warning --minimumFailingSeverity warning && eslint --max-warnings 0 . && prettier --check --log-level warn .",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/starlight": "^0.42.6",
    "@awesome-reveal/astro": "1.0.0-next.12",
    "astro": "^7.4.1",
    "hast-util-select": "^6.0.4",
    "hast-util-to-string": "^3.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "starlight-blog": "^0.30.2",
    "starlight-heading-badges": "^0.8.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-versions": "^0.10.1",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.2",
    "@eslint/js": "^10.0.1",
    "@lucide/astro": "^1.60.0",
    "@types/hast": "^3.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.151.2"
  }
}
