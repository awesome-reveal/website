---
import { Reveal } from "@awesome-reveal/astro";
---

<Reveal as="article" id="card">
  Hello
</Reveal>
<button id="check">Check</button>

<script>
  import { getReveal } from "@awesome-reveal/astro";

  const reveal = getReveal(document.querySelector("#card")!);

  document.querySelector("#check")!.addEventListener("click", () => {
    console.log(reveal.revealed ? "Revealed" : "Waiting");
  });
</script>
