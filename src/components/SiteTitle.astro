---
import Logo from "../assets/logo.svg";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <Logo aria-hidden="true" class="logo" />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--sl-color-white);
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.9rem + 1vw, 1.25rem);
    font-weight: 800;
    font-stretch: 78%;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo {
    flex: none;
    width: auto;
    height: 1.125rem;
    color: var(--sl-color-text-accent);
  }

  span {
    overflow: hidden;
  }
</style>
