---
import Heart from "@lucide/astro/icons/heart";
import { siteConfig } from "../site.config";

const { class: className } = Astro.props;
---

<footer class={className} data-markdown-ignore>
  <p>
    <small>
      <span>
        Released under the{" "}
        <a href={`${siteConfig.repoUrl}/blob/HEAD/LICENSE`}>MIT License</a>.
      </span>{" "}
      <span>
        Copyright © 2019-present{" "}
        <a href={siteConfig.author.url}>{siteConfig.author.name}</a>.
      </span>
    </small>
  </p>
  <a href={siteConfig.sponsorUrl}>
    <Heart color="var(--sl-color-red)" />
    Sponsor on GitHub
  </a>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  p {
    margin: 0;
  }

  small {
    font-size: inherit;
  }

  span {
    white-space: nowrap;
  }

  p a {
    color: var(--sl-color-gray-2);
    text-decoration-color: color-mix(in oklab, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
  }

  p a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
  }

  footer > a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1em;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--hover-duration) ease;
  }

  footer > a:hover {
    border-color: var(--sl-color-red);
  }
</style>
