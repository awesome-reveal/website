---
import { LinkButton } from "@astrojs/starlight/components";
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { Cascade, Reveal } from "@awesome-reveal/astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import Github from "../assets/github.svg";
import { getMarkdownSlug } from "../lib/markdown-slug";

// The hero schema of Starlight accepts only its own icon names, so the frontmatter name picks the icon here.
const icons = {
  external: ExternalLink,
  github: Github,
  "right-arrow": ArrowRight,
};

const { id, entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { scrollCueTarget } = data;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const words = title.split(" ");
const isHome = getMarkdownSlug(id) === "index";
// Starlight's generated 404 page has no actions, so it gives no way back.
const heroActions =
  id === "404" && actions.length === 0
    ? [
        {
          text: "Go to the home page",
          link: "/",
          variant: "primary" as const,
          icon: { type: "icon" as const, name: "right-arrow" as const },
          attrs: {},
        },
      ]
    : actions;
---

<div
  class:list={["hero", { home: isHome }]}
  id={isHome ? "intro" : undefined}
  data-slide={isHome ? "" : undefined}
  data-slide-label={isHome ? "Intro" : undefined}
>
  <Cascade
    as="h1"
    id="_top"
    data-page-title
    interval={110}
    duration={900}
    from={{ opacity: 0, y: "0.35em" }}
  >
    {words.map((word) => (
      <>
        <span set:html={word} />{" "}
      </>
    ))}
  </Cascade>
  {data.draft && <DraftContentNotice />}
  {tagline && (
    <Reveal as="p" class="tagline" delay={250}>
      <Fragment set:html={tagline} />
    </Reveal>
  )}
  {heroActions.length > 0 && (
    <Reveal class="actions" delay={350} from={{ opacity: 0, y: 12 }}>
      {heroActions.map(({ attrs, icon, link, text, variant }) => {
        const Icon =
          icon?.type === "icon"
            ? icons[icon.name as keyof typeof icons]
            : undefined;
        return (
          <LinkButton href={link} variant={variant} {...attrs}>
            {text}
            {Icon && <Icon aria-hidden="true" width="1em" height="1em" />}
          </LinkButton>
        );
      })}
    </Reveal>
  )}
  {scrollCueTarget && (
    <Reveal
      as="p"
      class="scroll-cue"
      delay={300}
      from={{ opacity: 0 }}
      duration={1200}
      data-markdown-ignore
    >
      <a href={`#${scrollCueTarget}`}>
        <span>
          <ArrowDown />
        </span>
        Scroll down
      </a>
    </Reveal>
  )}
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding-block: var(--space-2) var(--space-4);
  }

  @media (min-width: 50rem) {
    .hero {
      gap: var(--space-8);
      padding-block: clamp(
          var(--space-12),
          var(--space-8) + 12vmin,
          var(--space-32)
        )
        clamp(var(--space-8), var(--space-4) + 6vmin, var(--space-20));
    }
  }

  .home {
    min-block-size: calc(100svh - var(--sl-nav-height) - 6rem);
  }

  .home h1 {
    margin-block-start: auto;
  }

  /* The space above is on the paragraph, so the focus ring of the link fits its text. */
  .scroll-cue {
    margin-block-start: auto;
    padding-block-start: var(--space-8);
    font-size: var(--sl-text-base);
    font-weight: 600;
  }

  .scroll-cue a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    outline-offset: 2px;
    text-decoration: none;
    transition: color var(--hover-duration) ease;
  }

  .scroll-cue span {
    display: grid;
    place-items: center;
    inline-size: 2.25em;
    block-size: 2.25em;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    transition: border-color var(--hover-duration) ease;
  }

  @media (hover: hover) {
    .scroll-cue a:hover {
      color: var(--sl-color-white);
    }

    .scroll-cue a:hover span {
      border-color: var(--sl-color-text-accent);
    }
  }

  /* 3 × 1.2s stays under the 5s of WCAG 2.2.2, so the cue needs no pause control.
     The delay is the entrance of the cue: 300ms + 1200ms. */
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue :global(svg) {
      animation: scroll-cue-hop 1.2s 1.5s 3;
    }
  }

  /* The linear() stops are a bounce curve. */
  @keyframes scroll-cue-hop {
    0% {
      translate: 0 0;
      animation-timing-function: ease-out;
    }
    20% {
      translate: 0 -0.3em;
      animation-timing-function: linear(
        0,
        0.214 14.7%,
        0.386 23.7%,
        0.598 31.9%,
        0.999 44.7%,
        0.807 52.6%,
        0.762 56%,
        0.747 59.4%,
        0.758 62.4%,
        0.793 65.6%,
        0.999 77.4%,
        0.961 81.2%,
        0.949 84.8%,
        0.956 88%,
        0.993 95.5%,
        1
      );
    }
    75%,
    100% {
      translate: 0 0;
    }
  }

  h1 {
    color: var(--sl-color-white);
    font-size: clamp(3rem, 1rem + 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 span {
    display: inline-block;
  }

  .tagline {
    max-width: 36rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
</style>
