---
import { LinkButton } from "@astrojs/starlight/components";
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { Cascade, Reveal } from "@awesome-reveal/astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import Github from "../assets/github.svg";
import { getMarkdownSlug } from "../lib/markdown-slug";

// The hero schema of Starlight accepts only its own icon names, so the frontmatter name picks the icon here.
const icons = {
  external: ExternalLink,
  github: Github,
  "right-arrow": ArrowRight,
};

const { id, entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { scrollCueTarget } = data;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const words = title.split(" ");
const isHome = getMarkdownSlug(id) === "index";
// Starlight's generated 404 page has no actions, so it gives no way back.
const heroActions =
  id === "404" && actions.length === 0
    ? [
        {
          text: "Go to the home page",
          link: "/",
          variant: "primary" as const,
          icon: { type: "icon" as const, name: "right-arrow" as const },
          attrs: {},
        },
      ]
    : actions;
---

<div
  class:list={["hero", { home: isHome }]}
  id={isHome ? "intro" : undefined}
  data-slide={isHome ? "" : undefined}
  data-slide-label={isHome ? "Intro" : undefined}
>
  <Cascade
    as="h1"
    id="_top"
    data-page-title
    interval={110}
    duration={900}
    from={{ opacity: 0, y: "0.35em" }}
  >
    {words.map((word) => (
      <>
        <span set:html={word} />{" "}
      </>
    ))}
  </Cascade>
  {data.draft && <DraftContentNotice />}
  {tagline && (
    <Reveal as="p" class="tagline" delay={250}>
      <Fragment set:html={tagline} />
    </Reveal>
  )}
  {heroActions.length > 0 && (
    <Reveal class="actions" delay={350} from={{ opacity: 0, y: 12 }}>
      {heroActions.map(({ attrs, icon, link, text, variant }) => {
        const Icon =
          icon?.type === "icon"
            ? icons[icon.name as keyof typeof icons]
            : undefined;
        return (
          <LinkButton href={link} variant={variant} {...attrs}>
            {text}
            {Icon && <Icon aria-hidden="true" width="1em" height="1em" />}
          </LinkButton>
        );
      })}
    </Reveal>
  )}
  {scrollCueTarget && (
    <Reveal
      as="p"
      class="scroll-cue"
      delay={300}
      from={{ opacity: 0 }}
      duration={1200}
      data-markdown-ignore
    >
      <a href={`#${scrollCueTarget}`}>
        Scroll down
        <span class="keys">
          {" "}
          or press <kbd>↓</kbd>
        </span>
      </a>
    </Reveal>
  )}
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: 0.5rem 1rem;
  }

  @media (min-width: 50rem) {
    .hero {
      gap: 1.75rem;
      padding-block: clamp(3rem, 2rem + 12vmin, 9rem)
        clamp(2rem, 1rem + 6vmin, 5rem);
    }
  }

  .home {
    min-block-size: calc(100svh - var(--sl-nav-height) - 6rem);
  }

  .home h1 {
    margin-block-start: auto;
  }

  /* The space above is on the paragraph, so the focus ring of the link fits its text. */
  .scroll-cue {
    margin-block-start: auto;
    padding-block-start: 2rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }

  .scroll-cue a {
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-3);
    outline-offset: 2px;
    text-decoration: none;

    &:hover {
      color: var(--sl-color-white);
    }
  }

  /* SlideNav shows the hint where the keys step through the slides. */
  .keys {
    display: none;
  }

  kbd {
    padding: 0.05em 0.4em;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-sm);
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  h1 {
    color: var(--sl-color-white);
    font-size: clamp(3rem, 1rem + 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 span {
    display: inline-block;
  }

  .tagline {
    max-width: 36rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .sl-link-button :global(svg) {
    font-size: 1.5rem;
  }

  .sl-link-button {
    font-weight: 700;
    translate: 0;
    transition: translate var(--hover-duration) ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sl-link-button:hover {
      translate: 0 -2px;
    }

    .sl-link-button:active {
      translate: 0 1px;
    }
  }
</style>
