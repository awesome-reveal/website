---
import { LinkButton } from "@astrojs/starlight/components";
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { Cascade, Reveal } from "@awesome-reveal/astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import { getMarkdownSlug } from "../lib/markdown-slug";
import { getPrompt } from "../lib/prompts";
import CopyButton from "./CopyButton.astro";

// The hero schema of Starlight accepts only its own icon names, so the frontmatter name picks the icon here.
const icons = {
  external: ExternalLink,
  "right-arrow": ArrowRight,
};

const { id, entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { scrollCueTarget } = data;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const words = title.split(" ");
const isHome = getMarkdownSlug(id) === "index";
// Starlight's generated 404 page has no actions, so it gives no way back.
const heroActions =
  id === "404" && actions.length === 0
    ? [
        {
          text: "Go to the home page",
          link: "/",
          variant: "primary" as const,
          icon: { type: "icon" as const, name: "right-arrow" as const },
          attrs: {},
        },
      ]
    : actions;
const actionsWithPromptText = await Promise.all(
  heroActions.map(async (action) => ({
    ...action,
    promptText: action.prompt && (await getPrompt(action.prompt.id)).text,
  })),
);
---

<div
  class:list={["hero", { home: isHome }]}
  id={isHome ? "intro" : undefined}
  data-slide={isHome ? "" : undefined}
  data-slide-label={isHome ? "Intro" : undefined}
>
  <Cascade
    as="h1"
    id="_top"
    data-page-title
    interval={110}
    duration={900}
    from={{ opacity: 0, y: "0.35em" }}
  >
    {words.map((word) => (
      <>
        <span set:html={word} />{" "}
      </>
    ))}
  </Cascade>
  {data.draft && <DraftContentNotice />}
  {tagline && (
    <Reveal as="p" class="tagline" delay={250}>
      <Fragment set:html={tagline} />
    </Reveal>
  )}
  {actionsWithPromptText.length > 0 && (
    <Reveal class="actions" delay={350} from={{ opacity: 0, y: 12 }}>
      {actionsWithPromptText.map((action) => {
        if (action.promptText) {
          return (
            <CopyButton
              class:list={["action", "sl-link-button", action.variant]}
              text={action.promptText}
              copiedMessage="Prompt copied"
            >
              {action.text}
            </CopyButton>
          );
        }
        const { attrs, icon, link, text, variant } = action;
        const Icon =
          icon?.type === "icon"
            ? icons[icon.name as keyof typeof icons]
            : undefined;
        return (
          <LinkButton class="action" href={link} variant={variant} {...attrs}>
            {text}
            {Icon && <Icon aria-hidden="true" width="1em" height="1em" />}
          </LinkButton>
        );
      })}
    </Reveal>
  )}
  {scrollCueTarget && (
    <Reveal
      as="p"
      class="scroll-cue"
      delay={300}
      from={{ opacity: 0 }}
      duration={1200}
      data-markdown-ignore
    >
      <a href={`#${scrollCueTarget}`}>
        Scroll down
        <span class="keys">
          {" "}
          or press <kbd>↓</kbd>
        </span>
      </a>
    </Reveal>
  )}
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding-block: var(--space-2) var(--space-4);
  }

  @media (min-width: 50rem) {
    .hero {
      gap: var(--space-8);
      padding-block: clamp(
          var(--space-12),
          var(--space-8) + 12vmin,
          var(--space-32)
        )
        clamp(var(--space-8), var(--space-4) + 6vmin, var(--space-20));
    }
  }

  .home {
    min-block-size: calc(100svh - var(--sl-nav-height) - 6rem);
  }

  .home h1 {
    margin-block-start: auto;
  }

  /* The space above is on the paragraph, so the focus ring of the link fits its text. */
  .scroll-cue {
    margin-block-start: auto;
    padding-block-start: var(--space-8);
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }

  .scroll-cue a {
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-3);
    outline-offset: 2px;
    text-decoration: none;

    &:hover {
      color: var(--sl-color-white);
    }
  }

  /* SlideNav shows the hint where the keys step through the slides. */
  .keys {
    display: none;
  }

  kbd {
    padding: 0 0.5em;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-sm);
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  h1 {
    color: var(--sl-color-white);
    font-size: clamp(3rem, 1rem + 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 span {
    display: inline-block;
  }

  .tagline {
    max-width: 36rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* theme.css sets the weight, icon size and hover of .sl-link-button. */
  .action {
    gap: var(--space-2);
    padding-block: var(--space-2);
    padding-inline: var(--space-5);
    border-radius: 999rem;
    font-size: var(--sl-text-sm);
    line-height: 1.1875;
  }

  @media (min-width: 50rem) {
    .action {
      padding-block: var(--space-4);
      font-size: var(--sl-text-base);
    }
  }

  .action.minimal {
    padding-inline: 0;
  }

  /* LinkButton scopes its border and variant colors. */
  button.action {
    border: 1px solid transparent;
  }

  button.action.primary {
    border-color: var(--sl-color-text-accent);
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
  }

  button.action.secondary {
    border-color: inherit;
    color: var(--sl-color-white);
  }

  button.action.minimal {
    color: var(--sl-color-white);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
</style>
