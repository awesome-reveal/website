---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { hasMarkdownVersion } from "../lib/markdown-slug";
import PageActions from "./PageActions.astro";
import VersionNotice from "./VersionNotice.astro";

const { id } = Astro.locals.starlightRoute;
---

<VersionNotice />
{hasMarkdownVersion(id) ? (
  <div class="title">
    <Default />
    <PageActions class="actions" />
  </div>
) : (
  <Default />
)}

<style>
  /* The actions show above the h1 but follow it in the DOM, so the skip link to the h1 does not pass over them. */
  .title {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .actions {
    order: -1;
  }
  .title > :global(h1) {
    margin-block-start: 0;
  }
</style>
