---
import Default from "@astrojs/starlight/components/Footer.astro";
import SiteCredits from "./SiteCredits.astro";

// The built-in 404 entry of Starlight skips the schema, so `footer` is undefined there.
const showFooter = Astro.locals.starlightRoute.entry.data.footer !== false;
---

{showFooter && (
  <>
    <Default />
    <SiteCredits class="credits" />
  </>
)}

<style>
  .credits {
    margin-block-start: var(--space-12);
  }
</style>
