---
import { Cascade } from "@awesome-reveal/astro";
import {
  frameworkVariants,
  numberOptionCode,
} from "../../lib/snippet-variants";
import astro from "../../snippets/lists/card-list.astro?raw";
import js from "../../snippets/lists/card-list.js?raw";
import react from "../../snippets/lists/card-list.jsx?raw";
import vue from "../../snippets/lists/card-list.vue?raw";
import DemoFrame from "./DemoFrame.astro";
import FrameworkTabs from "./FrameworkTabs.astro";

interface Props {
  id: string;
  title: string;
  intervals: number[];
}

const { id, title, intervals } = Astro.props;

// The snippet files show this interval, and each choice replaces it.
const SNIPPET_INTERVAL = "80";

const values = intervals.map(String);
const CARD_COUNT = 6;
---

<DemoFrame
  id={id}
  title={title}
  name="interval"
  options={values}
  selected={SNIPPET_INTERVAL}
>
  {values.map((value) => (
    <div
      data-choice={value}
      data-selected={value === SNIPPET_INTERVAL ? "" : undefined}
    >
      <Cascade
        as="ul"
        class="cards"
        aria-hidden="true"
        interval={Number(value)}
        threshold={0.5}
      >
        {Array.from({ length: CARD_COUNT }, () => (
          <li class="demo-tile" />
        ))}
      </Cascade>
    </div>
  ))}
  <FrameworkTabs
    slot="code"
    selected={SNIPPET_INTERVAL}
    {...frameworkVariants(
      { react, vue, astro, js },
      numberOptionCode("interval"),
      SNIPPET_INTERVAL,
      values,
    )}
  />
</DemoFrame>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 4.5rem);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    aspect-ratio: 1;
    margin: 0;
  }
</style>
