---
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import ChoiceControl from "../ChoiceControl.astro";

interface Props {
  id: string;
  title: string;
  name?: string;
  options?: string[];
  selected?: string;
  replay?: boolean;
  motionNote?: string;
}

const {
  id,
  title,
  name = "",
  options = [],
  selected = "",
  replay = true,
  motionNote = "",
} = Astro.props;
const hasToolbar = options.length > 0 || replay;
---

<div class="demo-frame">
  <figure class="not-content" aria-label={title} data-markdown-ignore>
    <div class="stage">
      <slot />
    </div>
    {hasToolbar && (
      <div class="toolbar">
        {options.length > 0 && (
          <ChoiceControl
            id={id}
            name={name}
            selected={selected}
            options={options.map((value) => ({ value }))}
          />
        )}
        {replay && (
          <button type="button" class="replay" aria-label={`Replay ${title}`}>
            <RotateCcw aria-hidden="true" />
            <span class="replay-label">Replay</span>
          </button>
        )}
      </div>
    )}
    <p class="motion-note">
      Your device asks for reduced motion, so the content shows immediately,
      with no animation. {motionNote}
    </p>
  </figure>
  <slot name="code" />
</div>

<script>
  import type { RevealElement } from "@awesome-reveal/astro";

  for (const demo of document.querySelectorAll(".demo-frame")) {
    const stage = demo.querySelector(".stage")!;
    const choices = stage.querySelectorAll<HTMLElement>("[data-choice]");
    const snippets = demo.querySelectorAll<HTMLElement>("[data-snippet]");
    const shownHosts = () =>
      (choices.length > 0
        ? stage.querySelector("[data-choice][data-selected]")!
        : stage
      ).querySelectorAll<RevealElement>("awesome-reveal");

    const replay = () => {
      const hosts = shownHosts();
      for (const host of hosts) host.when = false;
      for (const host of hosts) host.when = true;
    };

    demo.querySelector(".options")?.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const { value } = event.target;
      for (const choice of choices) {
        choice.toggleAttribute(
          "data-selected",
          choice.dataset.choice === value,
        );
      }
      for (const snippet of snippets) {
        snippet.toggleAttribute(
          "data-current",
          snippet.dataset.snippet === value,
        );
      }
      replay();
    });

    demo.querySelector(".replay")?.addEventListener("click", replay);
  }
</script>

<style>
  figure {
    container: demo / inline-size;
    margin-block: var(--space-6);
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background-color: color-mix(
      in oklab,
      var(--sl-color-gray-6) 70%,
      transparent
    );
  }

  .stage {
    display: grid;
    place-items: center;
    min-block-size: 15rem;
    padding: var(--space-8) var(--space-4);
  }

  /* All choices and snippet variants share one grid cell, so the frame keeps the size of the largest one when the choice changes. */
  .stage > :global([data-choice]),
  .demo-frame :global(.snippet-variants > [data-snippet]) {
    grid-area: 1 / 1;
    margin: 0;
  }

  .stage > :global([data-choice]:not([data-selected])),
  .demo-frame :global(.snippet-variants > [data-snippet]:not([data-current])) {
    visibility: hidden;
  }

  /* Without `minmax(0, 1fr)`, the column grows to the longest code line, so the page scrolls instead of the code block. */
  .demo-frame :global(.snippet-variants) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  :where(.stage) :global(.demo-tile) {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    /* Forced colors remove the background, so the outline keeps the tile visible. */
    outline: 1px solid transparent;
    background-color: var(--marker);
    color: var(--ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 700;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-block-start: 1px solid var(--sl-color-hairline-light);
    --option-size: 2.25rem;
    /* The options with their padding and border. */
    --control-size: calc(var(--option-size) + 2 * var(--space-1) + 2px);
  }

  @media (pointer: coarse) {
    .toolbar {
      --option-size: 2.75rem;
    }
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--control-size);
    margin-inline-start: auto;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--hover-duration) ease,
      color var(--hover-duration) ease;

    @media (hover: hover) {
      &:hover {
        border-color: var(--sl-color-text-accent);
        color: var(--sl-color-white);
      }
    }
  }

  /* On a narrow demo, the control and the replay button share one row. */
  @container demo (max-width: 30rem) {
    .toolbar {
      flex-wrap: nowrap;
    }

    .replay-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .replay {
      flex: none;
      justify-content: center;
      inline-size: var(--control-size);
      padding: 0;
    }
  }

  .motion-note {
    display: none;
    margin: 0;
    padding: var(--space-3);
    border-block-start: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /* With reduced motion, `when: false` does not reset the entrance, so there is nothing to replay. */
  @media (prefers-reduced-motion: reduce) {
    .replay {
      display: none;
    }

    .motion-note {
      display: block;
    }
  }

  /* Without a script, the choice and the replay do nothing. */
  @media (scripting: none) {
    .toolbar {
      display: none;
    }
  }
</style>
