---
import ChoiceControl from "../ChoiceControl.astro";
import ReplayButton from "../ReplayButton.astro";

interface Props {
  id: string;
  title: string;
  name?: string;
  options?: string[];
  selected?: string;
  replay?: boolean;
  motionNote?: string;
}

const {
  id,
  title,
  name = "",
  options = [],
  selected = "",
  replay = true,
  motionNote = "",
} = Astro.props;
// The replay and the snippet switch find the shown choice by `selected`.
if (options.length > 0 && !options.includes(selected)) {
  throw new Error(
    `DemoFrame "${id}": selected "${selected}" is not in options ${options.join(", ")}`,
  );
}
const hasToolbar = options.length > 0 || replay;
// The RSS feed and llms-full.txt render entries outside a route, where this getter can throw.
function hasStarlightRoute(locals: typeof Astro.locals) {
  try {
    return Boolean(locals.starlightRoute);
  } catch {
    return false;
  }
}
const inFeed = !hasStarlightRoute(Astro.locals);
---

{inFeed ? (
  <p data-markdown-ignore>
    <em>Open the post on the website to try the interactive demo.</em>
  </p>
) : (
  <div class="demo-frame">
    <figure class="not-content" aria-label={title} data-markdown-ignore>
      <div class="stage">
        <slot />
      </div>
      {hasToolbar && (
        <div class="toolbar">
          {options.length > 0 && (
            <ChoiceControl
              id={id}
              name={name}
              selected={selected}
              options={options.map((value) => ({ value }))}
            />
          )}
          {replay && <ReplayButton class="toolbar-end" title={title} />}
        </div>
      )}
      <p class="motion-note">
        Your device asks for reduced motion, so the content shows with no
        animation. {motionNote}
      </p>
    </figure>
    <slot name="code" />
  </div>
)}

<script>
  import { getReveal } from "@awesome-reveal/astro";

  for (const demo of document.querySelectorAll(".demo-frame")) {
    const stage = demo.querySelector(".stage")!;
    const choices = stage.querySelectorAll<HTMLElement>("[data-choice]");
    const snippets = demo.querySelectorAll<HTMLElement>("[data-snippet]");
    const shownReveals = () =>
      [
        ...(choices.length > 0
          ? stage.querySelector("[data-choice][data-selected]")!
          : stage
        ).querySelectorAll("awesome-reveal > :first-child"),
      ].map(getReveal);

    const replay = () => {
      const reveals = shownReveals();
      for (const reveal of reveals) reveal.when = false;
      for (const reveal of reveals) reveal.when = true;
    };

    demo.querySelector(".options")?.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const { value } = event.target;
      for (const choice of choices) {
        choice.toggleAttribute(
          "data-selected",
          choice.dataset.choice === value,
        );
      }
      for (const snippet of snippets) {
        snippet.toggleAttribute(
          "data-current",
          snippet.dataset.snippet === value,
        );
      }
      replay();
    });

    demo.querySelector("[data-replay]")?.addEventListener("click", replay);
  }
</script>

<style>
  figure {
    container: demo / inline-size;
    margin-block: var(--space-6);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    /* With overflow: hidden, WebKit does not paint the fade of an inline child. */
    clip-path: inset(0 round var(--radius-md));
    background-color: color-mix(
      in oklab,
      var(--sl-color-gray-6) 70%,
      transparent
    );
  }

  .stage {
    display: grid;
    place-items: center;
    min-block-size: 15rem;
    padding: var(--space-8) var(--space-4);
  }

  /* All choices share one grid cell, so the frame keeps the size of the largest one when the choice changes. */
  .stage > :global([data-choice]) {
    grid-area: 1 / 1;
    margin: 0;
  }

  .stage > :global([data-choice]:not([data-selected])) {
    visibility: hidden;
  }

  :where(.stage) :global(.demo-tile) {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    /* Forced colors remove the background, so the outline keeps the tile visible. */
    outline: 1px solid transparent;
    background-color: var(--marker);
    color: var(--ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 700;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-block-start: 1px solid var(--sl-color-hairline-light);
    --option-size: 2.25rem;
    /* The options with their padding and border. */
    --control-size: calc(var(--option-size) + 2 * var(--space-1) + 2px);
  }

  @media (pointer: coarse) {
    .toolbar {
      --option-size: 2.75rem;
    }
  }

  .toolbar-end {
    margin-inline-start: auto;
  }

  /* On a narrow demo, the control and the replay button share one row. */
  @container demo (max-width: 30rem) {
    .toolbar {
      flex-wrap: nowrap;
    }
  }

  .motion-note {
    display: none;
    margin: 0;
    padding: var(--space-3);
    border-block-start: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-note {
      display: block;
    }
  }

  /* Without a script, the choice and the replay do nothing. */
  @media (scripting: none) {
    .toolbar {
      display: none;
    }
  }
</style>
