---
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import ChoiceControl from "../ChoiceControl.astro";

interface Props {
  id: string;
  title: string;
  name: string;
  options: string[];
  selected: string;
  motionNote?: string;
}

const { id, title, name, options, selected, motionNote = "" } = Astro.props;
---

<div class="demo-frame">
  <figure class="not-content" aria-label={title} data-markdown-ignore>
    <div class="stage">
      <slot />
    </div>
    <div class="toolbar">
      <ChoiceControl
        id={id}
        name={name}
        selected={selected}
        options={options.map((value) => ({ value }))}
      />
      <button type="button" class="replay" aria-label={`Replay ${title}`}>
        <RotateCcw aria-hidden="true" />
        <span class="replay-label">Replay</span>
      </button>
    </div>
    <p class="motion-note">
      Your device asks for reduced motion, so the content shows at once, with no
      animation. {motionNote}
    </p>
  </figure>
  <slot name="code" />
</div>

<script>
  import type { RevealElement } from "@awesome-reveal/astro";

  function replay(host: RevealElement | null | undefined) {
    if (!host) return;
    host.when = false;
    host.when = true;
  }

  for (const demo of document.querySelectorAll(".demo-frame")) {
    const choices = demo.querySelectorAll<HTMLElement>("[data-choice]");
    const snippets = demo.querySelectorAll<HTMLElement>("[data-snippet]");
    const selectedHost = () =>
      demo.querySelector<RevealElement>(
        "[data-choice][data-selected] awesome-reveal",
      );

    demo.querySelector(".options")?.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const { value } = event.target;
      for (const choice of choices) {
        choice.toggleAttribute(
          "data-selected",
          choice.dataset.choice === value,
        );
      }
      for (const snippet of snippets) {
        snippet.hidden = snippet.dataset.snippet !== value;
      }
      replay(selectedHost());
    });

    demo
      .querySelector(".replay")
      ?.addEventListener("click", () => replay(selectedHost()));
  }
</script>

<style>
  figure {
    container: demo / inline-size;
    margin-block: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background-color: color-mix(
      in oklab,
      var(--sl-color-gray-6) 70%,
      transparent
    );
  }

  .stage {
    display: grid;
    place-items: center;
    min-block-size: 15rem;
    padding: 2.5rem 1rem;
  }

  .stage > :global([data-choice]:not([data-selected])) {
    display: none;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.75rem;
    border-block-start: 1px solid var(--sl-color-hairline-light);
    --option-size: 2.25rem;
    /* The options with their padding and border. */
    --control-size: calc(var(--option-size) + 0.5rem + 2px);
  }

  @media (pointer: coarse) {
    .toolbar {
      --option-size: 2.75rem;
    }
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: var(--control-size);
    margin-inline-start: auto;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--hover-duration) ease,
      color var(--hover-duration) ease;

    @media (hover: hover) {
      &:hover {
        border-color: var(--sl-color-text-accent);
        color: var(--sl-color-white);
      }
    }
  }

  /* On a narrow demo, the control and the replay button share one row. */
  @container demo (max-width: 30rem) {
    .toolbar {
      flex-wrap: nowrap;
    }

    .replay-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .replay {
      flex: none;
      justify-content: center;
      inline-size: var(--control-size);
      padding: 0;
    }
  }

  .motion-note {
    display: none;
    margin: 0;
    padding: 0.75rem;
    border-block-start: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /* With reduced motion, `when: false` does not reset the entrance, so there is nothing to replay. */
  @media (prefers-reduced-motion: reduce) {
    .replay {
      display: none;
    }

    .motion-note {
      display: block;
    }
  }

  /* Without a script, the choice and the replay do nothing. */
  @media (scripting: none) {
    .toolbar {
      display: none;
    }
  }
</style>
