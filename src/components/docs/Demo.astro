---
import RotateCcw from "@lucide/astro/icons/rotate-ccw";

interface Props {
  id: string;
  caption: string;
}

const { id, caption } = Astro.props;
---

<figure class="demo not-content" data-markdown-ignore>
  <div class="stage">
    <slot />
  </div>
  <figcaption>
    <span id={`${id}-caption`}>{caption}</span>
    <button
      type="button"
      class="replay"
      aria-labelledby={`${id}-replay ${id}-caption`}
    >
      <RotateCcw aria-hidden="true" />
      <span id={`${id}-replay`}>Replay</span>
    </button>
  </figcaption>
  <p class="motion-note">
    Your device asks for reduced motion, so the demo shows the content at once,
    with no animation.
  </p>
</figure>

<script>
  import type { RevealElement } from "@awesome-reveal/astro";

  function replay(host: RevealElement) {
    host.when = false;
    host.when = true;
  }

  for (const demo of document.querySelectorAll(".demo")) {
    demo.querySelector(".replay")?.addEventListener("click", () => {
      for (const host of demo.querySelectorAll("awesome-reveal")) replay(host);
    });
  }
</script>

<style>
  .demo {
    container: demo / inline-size;
    margin-block: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background-color: color-mix(
      in oklab,
      var(--sl-color-gray-6) 70%,
      transparent
    );
  }

  .stage {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 7rem));
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1rem;
  }

  /* Four tiles wrap as 2 + 2, not 3 + 1. */
  @container demo (max-width: 32rem) {
    .stage {
      grid-template-columns: repeat(2, minmax(0, 7rem));
    }
  }

  .stage :global(.demo-tile) {
    display: grid;
    place-content: center;
    aspect-ratio: 1;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    background-color: var(--marker);
    color: var(--ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    text-align: center;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.5rem 0.75rem;
    border-block-start: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.25rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-family: var(--sl-font);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--hover-duration) ease,
      color var(--hover-duration) ease;

    &:hover {
      border-color: var(--sl-color-text-accent);
      color: var(--sl-color-white);
    }
  }

  @media (pointer: coarse) {
    .replay {
      min-block-size: 2.75rem;
    }
  }

  .motion-note {
    display: none;
    margin: 0;
    padding: 0 0.75rem 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-note {
      display: block;
    }

    .replay {
      display: none;
    }
  }
</style>
