---
import { Reveal } from "@awesome-reveal/astro";
import astro from "../../snippets/keyframes/spring-card.astro?raw";
import js from "../../snippets/keyframes/spring-card.js?raw";
import react from "../../snippets/keyframes/spring-card.jsx?raw";
import vue from "../../snippets/keyframes/spring-card.vue?raw";
import DemoFrame from "./DemoFrame.astro";
import FrameworkTabs from "./FrameworkTabs.astro";

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;

type Point = [x: number, y: number];

// The plot shows the progress from -0.1 to 1.25, so the overshoot above 1 stays inside it.
const toPlot = ([x, y]: Point): Point => [x * 100, (1.25 - y) * 60];
const END_LINE_Y = (1.25 - 1) * 60;

const formatPoints = (points: Point[]) =>
  points.map((point) => point.map((n) => +n.toFixed(2)).join(" ")).join(" ");

function bezierPath(x1: number, y1: number, x2: number, y2: number) {
  const points: Point[] = [
    [x1, y1],
    [x2, y2],
    [1, 1],
  ];
  return `M${formatPoints([toPlot([0, 0])])} C${formatPoints(points.map(toPlot))}`;
}

// Catmull-Rom: `S` mirrors the previous control point, so the slope does not break at a point.
// https://developer.mozilla.org/en-US/docs/Web/SVG/Tutorials/SVG_from_scratch/Paths#curve_commands
function smoothPath(points: Point[]) {
  const handles = points.map((point, index) => {
    const before = points[index - 1] ?? point;
    const after = points[index + 1] ?? point;
    const steps = (points[index - 1] ? 1 : 0) + (points[index + 1] ? 1 : 0);
    const slope: Point = [
      (after[0] - before[0]) / steps / 3,
      (after[1] - before[1]) / steps / 3,
    ];
    return {
      point,
      ahead: [point[0] + slope[0], point[1] + slope[1]] satisfies Point,
      behind: [point[0] - slope[0], point[1] - slope[1]] satisfies Point,
    };
  });
  const [start, ...rest] = handles;
  if (!start) return "";
  const segments = rest.map(({ point, behind }, index) =>
    index === 0
      ? `C${formatPoints([start.ahead, behind, point])}`
      : `S${formatPoints([behind, point])}`,
  );
  return `M${formatPoints([start.point])} ${segments.join(" ")}`;
}

// A damped spring (damping ratio 0.6), sampled every 10% of the time until it settles, as in the snippets.
const springProgress = [0, 0.62, 1.01, 1.12, 1.09, 1.03, 1];
const settledAt = (springProgress.length - 1) * 10;
const spring = `linear(${springProgress.join(", ")} ${settledAt}%, 1)`;
const springPath = smoothPath(
  [
    ...springProgress.map((y, index): Point => [index / 10, y]),
    [1, 1] satisfies Point,
  ].map(toPlot),
);

const easings = [
  { name: "ease-out", value: "ease-out", path: bezierPath(0, 0, 0.58, 1) },
  {
    name: "overshoot",
    value: "cubic-bezier(0.34, 1.56, 0.64, 1)",
    path: bezierPath(0.34, 1.56, 0.64, 1),
  },
  { name: "spring", value: spring, path: springPath },
];
---

<DemoFrame id={id} title={title}>
  <ul class="easings">
    {easings.map(({ name, value, path }) => (
      <li class="easing">
        <Reveal
          class="zoom-card demo-tile"
          keyframes={[
            { opacity: 0, scale: 0.4, easing: value },
            { opacity: 1, scale: 1 },
          ]}
          duration={1000}
          when={false}
        />
        <svg class="curve" viewBox="0 0 100 81" aria-hidden="true">
          <line
            class="end-line"
            x1="0"
            x2="100"
            y1={END_LINE_Y}
            y2={END_LINE_Y}
          />
          <path d={path} />
        </svg>
        <span class="name">{name}</span>
      </li>
    ))}
  </ul>
  <FrameworkTabs slot="code" react={react} vue={vue} astro={astro} js={js} />
</DemoFrame>

<script>
  import type {} from "@awesome-reveal/astro";

  // The cards must start together, so one observer starts them all instead of a viewport check for each card.
  for (const list of document.querySelectorAll(".easings")) {
    const hosts = list.querySelectorAll("awesome-reveal");
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        for (const host of hosts) host.when = true;
      },
      { threshold: 0.5 },
    );
    observer.observe(list);
  }
</script>

<style>
  .easings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    inline-size: 100%;
    max-inline-size: 28rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .easing {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  .zoom-card {
    inline-size: 4rem;
    aspect-ratio: 1;
  }

  .curve {
    inline-size: 100%;
    max-inline-size: 6rem;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .curve path {
    stroke: var(--marker);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }

  .end-line {
    stroke: var(--sl-color-gray-4);
    stroke-dasharray: 3 3;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .name {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }
</style>
