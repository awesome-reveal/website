---
import { Reveal, type Side, type StartState } from "@awesome-reveal/astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUp from "@lucide/astro/icons/arrow-up";
import { objectLiteral } from "../../lib/object-literal";
import { type Framework, snippetVariants } from "../../lib/snippet-variants";
import astroSnippet from "../../snippets/entrances/section-title.astro?raw";
import jsSnippet from "../../snippets/entrances/section-title.js?raw";
import reactSnippet from "../../snippets/entrances/section-title.jsx?raw";
import vueSnippet from "../../snippets/entrances/section-title.vue?raw";
import DemoFrame from "./DemoFrame.astro";
import FrameworkTabs from "./FrameworkTabs.astro";

interface Props {
  id: string;
  title: string;
  options: { label: string; from: Side | StartState }[];
  selected: string;
}

const { id, title, options, selected } = Astro.props;

const SIDE_OFFSET_PX = 24;
const sides = {
  top: { Arrow: ArrowDown, x: 0, y: -SIDE_OFFSET_PX },
  right: { Arrow: ArrowLeft, x: SIDE_OFFSET_PX, y: 0 },
  bottom: { Arrow: ArrowUp, x: 0, y: SIDE_OFFSET_PX },
  left: { Arrow: ArrowRight, x: -SIDE_OFFSET_PX, y: 0 },
};

const withUnit = (value: number | string, unit: string) =>
  typeof value === "number" ? `${value}${unit}` : value;

function startPositionStyle(from: Side | StartState) {
  if (typeof from === "string") {
    const { x, y } = sides[from];
    return { translate: `${x}px ${y}px` };
  }
  const { x = 0, y = 0, scale, rotate } = from;
  return {
    translate: `${withUnit(x, "px")} ${withUnit(y, "px")}`,
    ...(scale !== undefined && { scale }),
    ...(rotate !== undefined && { rotate: withUnit(rotate, "deg") }),
  };
}

type From = Side | StartState;

const jsxFrom = (from: From) =>
  typeof from === "string" ? `from="${from}"` : `from={${objectLiteral(from)}}`;

const snippets: Record<
  Framework,
  { code: string; from: (from: From) => string }
> = {
  react: { code: reactSnippet, from: jsxFrom },
  astro: { code: astroSnippet, from: jsxFrom },
  vue: {
    code: vueSnippet,
    from: (from) =>
      typeof from === "string"
        ? `from="${from}"`
        : `:from="${objectLiteral(from).replaceAll('"', "'")}"`,
  },
  js: {
    code: jsSnippet,
    from: (from) =>
      `from: ${typeof from === "string" ? `"${from}"` : objectLiteral(from)}`,
  },
};

// The snippet files show this side, and each choice replaces it.
const SNIPPET_FROM = "bottom";

function entranceVariants(framework: Framework) {
  const { code, from: fromCode } = snippets[framework];
  return snippetVariants(
    code,
    fromCode(SNIPPET_FROM),
    options.map(({ label, from }) => ({ value: label, code: fromCode(from) })),
  );
}

const choices = options.map(({ label, from }) => ({
  label,
  from,
  Arrow: typeof from === "string" ? sides[from].Arrow : undefined,
  startPosition: startPositionStyle(from),
}));
---

<DemoFrame
  id={id}
  title={title}
  name="from"
  options={options.map(({ label }) => label)}
  selected={selected}
  motionNote="The dashed outline shows where the entrance starts."
>
  {choices.map(({ label, from, Arrow, startPosition }) => (
    <div
      class="choice"
      data-choice={label}
      data-selected={label === selected ? "" : undefined}
    >
      <div class="start" style={startPosition} aria-hidden="true" />
      <Reveal class="tile demo-tile" from={from} threshold={0.5}>
        {Arrow && <Arrow class="arrow" aria-hidden="true" />}
      </Reveal>
    </div>
  ))}
  <FrameworkTabs
    slot="code"
    selected={selected}
    react={entranceVariants("react")}
    vue={entranceVariants("vue")}
    astro={entranceVariants("astro")}
    js={entranceVariants("js")}
  />
</DemoFrame>

<style>
  .choice {
    display: grid;
  }

  /* The host of Reveal has display: contents, so the tile is a grid item of the choice. */
  .start,
  .tile {
    grid-area: 1 / 1;
    inline-size: 8rem;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
  }

  /* The outline is above the tile, so a start state inside the tile, such as a zoom, stays visible. */
  .start {
    z-index: 1;
    border: 2px dashed var(--sl-color-gray-3);
    pointer-events: none;
    /* Without its own layer, Safari leaves a trail of the old outline after a choice change. */
    will-change: transform;
  }

  .arrow {
    font-size: 1.75rem;
  }
</style>
