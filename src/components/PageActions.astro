---
import Check from "@lucide/astro/icons/check";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Copy from "@lucide/astro/icons/copy";
import FileText from "@lucide/astro/icons/file-text";
import X from "@lucide/astro/icons/x";
import ClaudeLogo from "../assets/claude.svg";
import OpenaiLogo from "../assets/openai.svg";
import { getMarkdownPath } from "../lib/markdown-slug";
import { isArchived } from "../lib/versions";

const { id } = Astro.locals.starlightRoute;
const markdown = getMarkdownPath(id);
const prompt = encodeURIComponent(
  `Read ${new URL(Astro.url.pathname, Astro.site).href} so I can ask questions about it.`,
);
// The archive documents a legacy package, and llms.txt leaves it out.
const askLinks = isArchived(id)
  ? []
  : [
      { name: "Claude", url: "https://claude.ai/new?q=", Logo: ClaudeLogo },
      { name: "ChatGPT", url: "https://chatgpt.com/?q=", Logo: OpenaiLogo },
    ];
---

<div class="page-actions" data-markdown-ignore data-pagefind-ignore>
  <div class="split">
    <button type="button" class="copy" data-copy={markdown} data-state="idle">
      <span class="icon">
        <Copy data-icon="idle" />
        <Check data-icon="copied" />
        <X data-icon="failed" />
      </span>
      <span>Copy page</span>
    </button>
    <button
      type="button"
      class="more"
      id="page-actions-trigger"
      aria-label="More page actions"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="page-actions-menu"
    >
      <ChevronDown />
    </button>
    <ul
      class="menu"
      id="page-actions-menu"
      role="menu"
      aria-labelledby="page-actions-trigger"
      tabindex="-1"
      hidden
    >
      <li role="none">
        <a href={markdown} role="menuitem" tabindex="-1">
          <FileText />
          View as Markdown
        </a>
      </li>
      {askLinks.map(({ name, url, Logo }) => (
        <li role="none">
          <a
            href={url + prompt}
            role="menuitem"
            tabindex="-1"
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`Ask ${name} about this page (opens in a new tab)`}
          >
            <Logo aria-hidden="true" width="1em" height="1em" />
            Ask {name}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <span class="sr-only" role="status" data-status></span>
</div>

<style>
  .page-actions {
    display: flex;
    justify-content: flex-end;
  }
  @media (scripting: none) {
    .page-actions {
      display: none;
    }
  }
  .split {
    position: relative;
    display: inline-flex;
  }
  .copy,
  .more {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    box-sizing: border-box;
    height: 1.875rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--sl-color-hairline-light);
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    transition:
      border-color var(--hover-duration) ease,
      color var(--hover-duration) ease;
  }
  .copy {
    padding-inline-start: var(--space-4);
    border-radius: 999px 0 0 999px;
  }
  .icon {
    display: grid;
  }
  [data-icon] {
    grid-area: 1 / 1;
    opacity: 0;
    scale: 0.25;
    filter: blur(2px);
  }
  .copy[data-state="idle"] [data-icon="idle"],
  .copy[data-state="copied"] [data-icon="copied"],
  .copy[data-state="failed"] [data-icon="failed"] {
    opacity: 1;
    scale: 1;
    filter: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-icon] {
      transition:
        opacity var(--hover-duration) ease,
        scale var(--hover-duration) ease,
        filter var(--hover-duration) ease;
    }
  }
  /* The halves overlap by one border, and the active half sits on top to show its whole outline. */
  .more {
    margin-inline-start: -1px;
    padding-inline: var(--space-2) var(--space-3);
    border-radius: 0 999px 999px 0;
  }
  /* Astro does not scope a compound that starts with :is(). */
  button:is(.copy, .more):is(:hover, :focus-visible),
  .more[aria-expanded="true"] {
    z-index: 1;
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-white);
  }
  .menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-1));
    inset-inline-end: 0;
    z-index: 2;
    min-width: 12rem;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background: var(--sl-color-bg-nav);
  }
  li {
    margin: 0;
  }
  a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  /* Not :hover alone: an item under a resting pointer would stay active after an arrow key moves the focus.
     The inset ring keeps a gap to the menu border. */
  a:hover:focus,
  a:focus-visible {
    outline-offset: -2px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("button[data-copy]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  if (button && status) {
    let timer: ReturnType<typeof setTimeout>;

    const show = (state: "copied" | "failed", message: string) => {
      button.dataset.state = state;
      status.textContent = message;
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.dataset.state = "idle";
        status.textContent = "";
      }, 2000);
    };

    button.addEventListener("click", async () => {
      try {
        const response = await fetch(button.dataset.copy!);
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
        show("copied", "Page copied as Markdown");
      } catch {
        show("failed", "Copy failed");
      }
    });
  }

  // The menu button pattern of the WAI-ARIA APG: https://www.w3.org/WAI/ARIA/apg/patterns/menu-button/
  const trigger = document.getElementById("page-actions-trigger");
  const menu = document.getElementById("page-actions-menu");

  if (trigger && menu) {
    const items = [...menu.querySelectorAll<HTMLElement>("[role=menuitem]")];
    const isOpen = () => !menu.hidden;
    const focusItem = (index: number) =>
      items[(index + items.length) % items.length]?.focus();
    const menuItemAt = (target: EventTarget | null) =>
      (target as Element).closest<HTMLElement>("[role=menuitem]");
    const hasModifier = (event: KeyboardEvent) =>
      event.altKey || event.ctrlKey || event.metaKey;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    };
    const open = (index: number) => {
      setOpen(true);
      focusItem(index);
    };
    const close = ({ returnFocus = false } = {}) => {
      if (!isOpen()) return;
      setOpen(false);
      if (returnFocus) trigger.focus();
    };

    trigger.addEventListener("click", () =>
      isOpen() ? close({ returnFocus: true }) : open(0),
    );
    // Keeps the focus in the menu, so the focusout below does not close it before this click toggles it.
    trigger.addEventListener("mousedown", (event) => {
      if (isOpen()) event.preventDefault();
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        open(event.key === "ArrowDown" ? 0 : -1);
      }
    });

    menu.addEventListener("keydown", (event) => {
      if (hasModifier(event)) return;
      // -1 when the menu itself has the focus, after a press on its padding.
      const current = items.indexOf(document.activeElement as HTMLElement);
      switch (event.key) {
        case "ArrowDown":
          focusItem(current + 1);
          break;
        case "ArrowUp":
          focusItem((current === -1 ? 0 : current) - 1);
          break;
        case "Home":
          focusItem(0);
          break;
        case "End":
          focusItem(-1);
          break;
        case "Escape":
          close({ returnFocus: true });
          break;
        case " ":
          break;
        default: {
          if (event.key.length !== 1) return;
          const key = event.key.toLowerCase();
          const next = [
            ...items.slice(current + 1),
            ...items.slice(0, current + 1),
          ].find((item) =>
            item.textContent!.trim().toLowerCase().startsWith(key),
          );
          next?.focus();
        }
      }
      event.preventDefault();
    });
    // A link ignores Space, but the APG activates a menu item on it. On keydown, the keyup that follows
    // would reach the trigger after the focus returns to it, and it could open the menu again.
    menu.addEventListener("keyup", (event) => {
      if (event.key === " " && !hasModifier(event)) {
        menuItemAt(event.target)?.click();
      }
    });
    menu.addEventListener("click", (event) => {
      if (menuItemAt(event.target)) close({ returnFocus: true });
    });
    // The hovered item takes the focus, so that only one item shows as active.
    menu.addEventListener("pointermove", (event) => {
      menuItemAt(event.target)?.focus({ preventScroll: true });
    });
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !menu.contains(next)) close();
    });
    // Not click: iOS Safari sends no click for a tap on content that is not interactive.
    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Node;
      if (!menu.contains(target) && !trigger.contains(target)) close();
    });
  }
</script>
