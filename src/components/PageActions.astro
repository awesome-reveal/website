---
import Check from "@lucide/astro/icons/check";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Copy from "@lucide/astro/icons/copy";
import FileText from "@lucide/astro/icons/file-text";
import X from "@lucide/astro/icons/x";
import ClaudeLogo from "../assets/claude.svg";
import OpenaiLogo from "../assets/openai.svg";
import { getMarkdownPath } from "../lib/markdown-slug";
import { isArchived } from "../lib/versions";

const { id } = Astro.locals.starlightRoute;
const markdown = getMarkdownPath(id);
const prompt = encodeURIComponent(
  `Read ${new URL(Astro.url.pathname, Astro.site).href} so I can ask questions about it.`,
);
// The archive documents a legacy package, and llms.txt leaves it out.
const askLinks = isArchived(id)
  ? []
  : [
      { name: "Claude", url: "https://claude.ai/new?q=", Logo: ClaudeLogo },
      { name: "ChatGPT", url: "https://chatgpt.com/?q=", Logo: OpenaiLogo },
    ];
---

<div class="actions" data-markdown-ignore data-pagefind-ignore>
  <div class="split">
    <button type="button" class="copy" data-copy={markdown}>
      <span class="icon">
        <Copy data-icon="idle" />
        <Check data-icon="copied" />
        <X data-icon="failed" />
      </span>
      <span>Copy page</span>
    </button>
    <details class="more">
      <summary aria-label="More page actions">
        <ChevronDown />
      </summary>
      <ul class="menu">
        <li>
          <a href={markdown}>
            <FileText />
            View as Markdown
          </a>
        </li>
        {askLinks.map(({ name, url, Logo }) => (
          <li>
            <a
              href={url + prompt}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={`Ask ${name} about this page (opens in a new tab)`}
            >
              <Logo aria-hidden="true" width="1em" height="1em" />
              Ask {name}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
  <span class="status" role="status" data-status></span>
  <noscript>
    <style is:inline>
      /* The copy button needs JavaScript. Without it, only the menu shows, so the menu needs a label. */
      .actions .copy {
        display: none;
      }
      .actions .more {
        margin-inline-start: 0;
      }
      .actions summary {
        border-radius: 999px;
      }
      .actions summary::before {
        content: "Page actions";
      }
    </style>
  </noscript>
</div>

<style>
  .actions {
    display: flex;
    justify-content: flex-end;
  }
  .split {
    position: relative;
    display: inline-flex;
  }
  .copy,
  summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    box-sizing: border-box;
    height: 1.875rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--sl-color-hairline-light);
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    transition:
      border-color var(--hover-duration) ease,
      color var(--hover-duration) ease;
  }
  .copy {
    padding-inline-start: var(--space-4);
    border-radius: 999px 0 0 999px;
  }
  .icon {
    display: grid;
  }
  [data-icon] {
    grid-area: 1 / 1;
    opacity: 0;
    scale: 0.25;
    filter: blur(2px);
  }
  .copy:not([data-state]) [data-icon="idle"],
  .copy[data-state="copied"] [data-icon="copied"],
  .copy[data-state="failed"] [data-icon="failed"] {
    opacity: 1;
    scale: 1;
    filter: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-icon] {
      transition:
        opacity var(--hover-duration) ease,
        scale var(--hover-duration) ease,
        filter var(--hover-duration) ease;
    }
  }
  summary {
    list-style: none;
    padding-inline: var(--space-2) var(--space-3);
    border-radius: 0 999px 999px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* The halves overlap by one border, and the active half sits on top to show its whole outline. */
  .more {
    margin-inline-start: -1px;
  }
  .copy:hover,
  .copy:focus-visible,
  summary:hover,
  summary:focus-visible,
  .more[open] summary {
    z-index: 1;
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-white);
  }
  .menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-1));
    inset-inline-end: 0;
    z-index: 2;
    min-width: 12rem;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background: var(--sl-color-bg-nav);
  }
  li {
    margin: 0;
  }
  a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("button[data-copy]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  if (button && status) {
    let timer: ReturnType<typeof setTimeout>;

    const show = (state: "copied" | "failed", message: string) => {
      button.dataset.state = state;
      status.textContent = message;
      clearTimeout(timer);
      timer = setTimeout(() => {
        delete button.dataset.state;
        status.textContent = "";
      }, 2000);
    };

    button.addEventListener("click", async () => {
      try {
        const response = await fetch(button.dataset.copy!);
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
        show("copied", "Page copied as Markdown");
      } catch {
        show("failed", "Copy failed");
      }
    });
  }

  const menu = document.querySelector<HTMLDetailsElement>(".actions .more");
  if (menu) {
    const close = () => (menu.open = false);
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target as Node)) close();
    });
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) close();
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        close();
        menu.querySelector("summary")!.focus();
      }
    });
  }
</script>
