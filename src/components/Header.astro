---
import SocialIcons from "./SocialIcons.astro";
import VersionSelect from "./VersionSelect.astro";
// The plugin's Search override limits the search to the version of the page.
import Search from "starlight-versions/overrides/Search.astro";
import SiteTitle from "./SiteTitle.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<div class="header">
  <div class="title-wrapper">
    <SiteTitle />
  </div>
  <div class="search print:hidden">
    <Search />
  </div>
  <div class="controls print:hidden">
    <div class="versions">
      <VersionSelect />
    </div>
    <div class="social-icons">
      <SocialIcons />
    </div>
    <ThemeToggle />
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    height: 100%;
  }

  /* Keeps a long title from covering the buttons, without clipping its focus ring. */
  .title-wrapper {
    display: flex;
    min-width: 0;
    margin: calc(-1 * var(--space-1));
    padding: var(--space-1);
    overflow: clip;
  }

  .search {
    display: flex;
    margin-inline-start: auto;
  }

  @media (max-width: 49.99rem) {
    .search :global(button[data-open-modal]) {
      justify-content: center;
      width: var(--header-button-size);
      height: var(--header-button-size);
      padding: 0;
      border-radius: 999px;
      color: var(--sl-color-gray-2);
      font-size: var(--header-icon-size);
    }

    .search :global(button[data-open-modal]:hover) {
      color: var(--sl-color-white);
    }
  }

  .search :global(button > kbd) {
    border-radius: 999px;
    padding-inline: var(--space-2);
  }

  .search :global(dialog) {
    border-color: var(--sl-color-hairline-light);
  }

  .search :global(#starlight__search) {
    --sl-search-corners: var(--radius-md);
    --pagefind-ui-border-radius: var(--radius-md);
  }

  /* The search shows focus with the accent border. Forced colors mode flattens borders, so it shows the transparent outline instead. */
  .search :global(#starlight__search input:focus) {
    outline: 2px solid transparent;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .social-icons {
    display: flex;
  }

  .social-icons :global(a) {
    align-items: center;
    justify-content: center;
    width: var(--header-button-size);
    height: var(--header-button-size);
    margin: 0;
    padding: 0;
    border-radius: 999px;
    font-size: var(--header-icon-size);
  }

  .versions {
    display: none;
  }

  /* With the menu button, the title needs this space on narrow phones. The menu footer shows the icons there. */
  @media (max-width: 24.99rem) {
    :global(:root[data-has-sidebar]) .social-icons {
      display: none;
    }
  }

  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }

    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }

    /* Starlight's column math: the search starts at the left edge of the content column. */
    .header {
      --__sidebar-width: max(
        0rem,
        var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)
      );
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) -
              var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) -
              var(--sl-content-inline-start, 0rem) - var(--sl-content-width)
          ) /
          2
      );
      display: grid;
      gap: var(--sl-nav-gap);
      grid-template-columns:
        minmax(
          calc(
            var(--__sidebar-width) +
              max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))
          ),
          auto
        )
        1fr auto;
    }

    .search {
      margin-inline-start: 0;
    }

    .search :global(button[data-open-modal]) {
      border-color: var(--sl-color-hairline-light);
      border-radius: 999px;
      padding-inline: var(--space-4) var(--space-2);
      transition: border-color var(--hover-duration) ease;
    }

    .search :global(button[data-open-modal]:hover) {
      border-color: var(--sl-color-text-accent);
    }

    .search :global(dialog) {
      border-radius: 1rem;
    }

    .versions {
      display: flex;
      margin-inline-end: var(--space-2);
    }
  }
</style>
