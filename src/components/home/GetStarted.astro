---
import { Code, LinkButton, TabItem, Tabs } from "@astrojs/starlight/components";
import { Reveal } from "@awesome-reveal/astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Github from "../../assets/github.svg";

const frameworks = [
  {
    label: "React",
    pkg: "@awesome-reveal/react",
    lang: "jsx",
    code: `import { Reveal } from "@awesome-reveal/react";

export const Hero = () => (
  <Reveal from="left">
    <h1>Hello</h1>
  </Reveal>
);`,
  },
  {
    label: "Vue",
    pkg: "@awesome-reveal/vue",
    lang: "vue",
    code: `<script setup>
import { Reveal } from "@awesome-reveal/vue";
</script>

<template>
  <Reveal from="left">
    <h1>Hello</h1>
  </Reveal>
</template>`,
  },
  {
    label: "Astro",
    pkg: "@awesome-reveal/astro",
    lang: "astro",
    // A line that starts with `---` ends the frontmatter for editor parsers, so the fences are interpolated.
    code: `${"---"}
import { Reveal } from "@awesome-reveal/astro";
${"---"}

<Reveal from="left">
  <h1>Hello</h1>
</Reveal>`,
  },
  {
    label: "JavaScript",
    pkg: "@awesome-reveal/core",
    lang: "js",
    code: `import { reveal } from "@awesome-reveal/core";

reveal("h1", { from: "left" });`,
  },
];
---

{/* The credits in the slot belong to the page, so they stay outside the section. */}
<div
  id="get-started"
  class="get-started not-content"
  data-slide
  data-slide-label="Get started"
>
  <section>
    <Reveal class="intro" threshold={0.5}>
      <h2 class="slide-title">Start in under a minute</h2>
      <p class="slide-lead">
        Pick your framework, install one package and wrap an element. Each
        package includes skills for AI agents. All four packages share the same
        core, the same entrance options and TypeScript types.
      </p>
    </Reveal>
    <Reveal class="code slide-code" threshold={0.2} delay={120}>
      <Tabs syncKey="framework">
        {frameworks.map(({ label, pkg, lang, code }) => (
          <TabItem label={label}>
            <Code code={`pnpm add ${pkg}`} lang="shell" />
            <Code code={code} lang={lang} />
          </TabItem>
        ))}
      </Tabs>
    </Reveal>
    <Reveal class="actions" threshold={0.5} from={{ opacity: 0, y: 12 }}>
      <LinkButton href="/getting-started/" variant="primary">
        Read the docs
        <ArrowRight aria-hidden="true" width="1em" height="1em" />
      </LinkButton>
      <LinkButton
        href="https://github.com/awesome-reveal/awesome-reveal"
        variant="secondary"
      >
        Star on GitHub
        <Github aria-hidden="true" width="1em" height="1em" />
      </LinkButton>
    </Reveal>
  </section>
  <slot />
</div>

<style>
  .get-started {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    padding-block: var(--space-16) var(--space-8);
  }

  .get-started > section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
  }

  @media (min-width: 56rem) {
    .get-started {
      min-block-size: calc(100svh - var(--sl-nav-height));
      padding-block-start: var(--space-16);
    }

    /* The auto margins center the content above the credits. */
    .get-started > section {
      margin-block: auto;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      /* The code also spans the empty last row, which takes its extra height, so the button stays under the lead. */
      grid-template-rows: min-content min-content auto;
      align-items: start;
      gap: var(--space-8) var(--space-16);
    }

    .code {
      grid-column: 2;
      grid-row: 1 / -1;
    }

    .actions {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .code :global(.expressive-code + .expressive-code) {
    margin-block-start: var(--space-4);
  }

  /* The panels share one cell, so the tallest sets the height and a tab change does not move the centered section.
     The stacked layout is not centered, so a tab change moves only the button, and the button stays close to the code. */
  @media (min-width: 56rem) {
    .code :global(starlight-tabs) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .code :global(starlight-tabs > [role="tabpanel"]) {
      grid-area: 2 / 1;
    }

    .code :global(starlight-tabs > [role="tabpanel"][hidden]) {
      display: block;
      visibility: hidden;
    }
  }

  /* Starlight gives a button in Markdown content a margin. Here the grid gap sets the space. */
  .sl-link-button {
    margin: 0;
  }
</style>
