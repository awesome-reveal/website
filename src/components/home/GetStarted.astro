---
import { Code, LinkButton, TabItem, Tabs } from "@astrojs/starlight/components";
import { Reveal } from "@awesome-reveal/astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { getPrompt } from "../../lib/prompts";
import CopyButton from "../CopyButton.astro";

const { text: getStartedPrompt } = await getPrompt("get-started");

const frameworks = [
  {
    label: "React",
    pkg: "@awesome-reveal/react",
    guide: "/frameworks/react/",
    lang: "jsx",
    code: `import { Reveal } from "@awesome-reveal/react";

export const Hero = () => (
  <Reveal from="left">
    <h1>Hello</h1>
  </Reveal>
);`,
  },
  {
    label: "Vue",
    pkg: "@awesome-reveal/vue",
    guide: "/frameworks/vue/",
    lang: "vue",
    code: `<script setup>
import { Reveal } from "@awesome-reveal/vue";
</script>

<template>
  <Reveal from="left">
    <h1>Hello</h1>
  </Reveal>
</template>`,
  },
  {
    label: "Astro",
    pkg: "@awesome-reveal/astro",
    guide: "/frameworks/astro/",
    lang: "astro",
    // A line that starts with `---` ends the frontmatter for editor parsers, so the fences are interpolated.
    code: `${"---"}
import { Reveal } from "@awesome-reveal/astro";
${"---"}

<Reveal from="left">
  <h1>Hello</h1>
</Reveal>`,
  },
  {
    label: "JavaScript",
    pkg: "@awesome-reveal/core",
    guide: "/frameworks/javascript/",
    lang: "js",
    code: `import { reveal } from "@awesome-reveal/core";

reveal("h1", { from: "left" });`,
  },
];
---

{/* The credits in the slot belong to the page, so they stay outside the section. */}
<div
  id="get-started"
  class="get-started not-content"
  data-slide
  data-slide-label="Get started"
>
  <section>
    <Reveal class="intro" threshold={0.5}>
      <h2 class="slide-title">Start in under a minute</h2>
      <p class="slide-lead">
        Pick your framework, install one package and wrap an element. Each
        package includes skills for AI agents. All four packages share the same
        core, the same entrance options and TypeScript types.
      </p>
    </Reveal>
    <Reveal class="code slide-code" threshold={0.2} delay={120}>
      <Tabs syncKey="framework">
        {frameworks.map(({ label, pkg, guide, lang, code }) => (
          <TabItem label={label}>
            <Code code={`pnpm add ${pkg}`} lang="shell" />
            <Code code={code} lang={lang} />
            <a class="guide" href={guide}>
              {label} scroll animations
              <ArrowRight />
            </a>
          </TabItem>
        ))}
      </Tabs>
    </Reveal>
    <Reveal class="actions" threshold={0.5} from={{ opacity: 0, y: 12 }}>
      <LinkButton href="/getting-started/" variant="primary">
        Read the docs
        <ArrowRight width="1em" height="1em" />
      </LinkButton>
      <CopyButton
        class="copy-prompt sl-link-button secondary"
        text={getStartedPrompt}
        copiedMessage="Prompt copied"
      >
        Copy prompt
      </CopyButton>
    </Reveal>
  </section>
  <slot />
</div>

<style>
  .get-started {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    padding-block: var(--space-16) var(--space-8);
  }

  /* The auto margins center the content above the credits. */
  .get-started > section {
    display: grid;
    margin-block: auto;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
  }

  @media (min-width: 56rem) {
    .get-started > section {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      /* The code also spans the empty last row, which takes its extra height, so the button stays under the lead. */
      grid-template-rows: min-content min-content auto;
      align-items: start;
      gap: var(--space-8) var(--space-16);
    }

    .code {
      grid-column: 2;
      grid-row: 1 / -1;
    }

    .actions {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .code :global(.expressive-code + .expressive-code) {
    margin-block-start: var(--space-4);
  }

  .guide {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    outline-offset: 2px;
    transition: color var(--hover-duration) ease;
  }

  .guide:hover {
    color: var(--sl-color-white);
  }

  /* The panels share one cell, so the tallest sets the height and a tab change does not move the centered section.
     The stacked layout is not centered, so a tab change moves only the button, and the button stays close to the code. */
  @media (min-width: 56rem) {
    .code :global(starlight-tabs) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .code :global(starlight-tabs > [role="tabpanel"]) {
      grid-area: 2 / 1;
    }

    .code :global(starlight-tabs > [role="tabpanel"][hidden]) {
      display: block;
      visibility: hidden;
    }
  }

  /* Starlight gives a button in Markdown content a margin. Here the grid gap sets the space. */
  .sl-link-button {
    margin: 0;
  }

  /* LinkButton scopes its box and colors, so the copy button repeats them. theme.css sets the weight, icon size and hover. */
  .copy-prompt {
    gap: 0.5em;
    padding: 0.4375rem 1.125rem;
    border: 1px solid;
    border-radius: 999rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    line-height: 1.1875;
  }

  @media (min-width: 50rem) {
    .copy-prompt {
      padding: 0.9375rem 1.25rem;
      font-size: var(--sl-text-base);
    }
  }
</style>
