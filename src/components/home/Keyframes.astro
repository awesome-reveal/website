---
import type { RevealOptions } from "@awesome-reveal/astro";
import { Cascade } from "@awesome-reveal/astro";
import Chapter from "./Chapter.astro";
import { objectLiteral } from "../../lib/object-literal";

type Keyframes = NonNullable<RevealOptions["keyframes"]>;

const presets: { name: string; property: string; keyframes: Keyframes }[] = [
  {
    name: "Flip",
    property: "rotate",
    keyframes: [
      { opacity: 0, rotate: "x -80deg", easing: "ease-out" },
      { opacity: 1, rotate: "x 12deg", offset: 0.6 },
      { opacity: 1, rotate: "x 0deg" },
    ],
  },
  {
    name: "Pop",
    property: "scale",
    keyframes: [
      { opacity: 0, scale: 0.3, easing: "ease-out" },
      { opacity: 1, scale: 1.12, offset: 0.6 },
      { opacity: 1, scale: 1 },
    ],
  },
  {
    name: "Drop",
    property: "translate",
    keyframes: [
      { opacity: 0, translate: "0 -80px", easing: "ease-in" },
      { opacity: 1, translate: "0 8px", offset: 0.6, easing: "ease-out" },
      { opacity: 1, translate: "0 0" },
    ],
  },
];
const selected = "Flip";

const control = {
  name: "keyframes",
  selected,
  options: presets.map(({ name, keyframes }) => ({
    value: name,
    code: `<Cascade
  keyframes={[
${keyframes.map((keyframe) => `    ${objectLiteral(keyframe)},`).join("\n")}
  ]}
>
  {cards}
</Cascade>`,
  })),
};

const decks = presets.map((preset) => ({
  ...preset,
  cards: preset.keyframes.map((keyframe, index) => ({
    offset: String(keyframe.offset ?? index / (preset.keyframes.length - 1)),
    value: String(keyframe[preset.property]),
  })),
}));
---

<Chapter
  id="keyframes"
  label="Keyframes"
  title="Your keyframes, native speed"
  control={control}
>
  <p>
    Need a flip, a bounce or a 3D turn? Pass native Web Animations keyframes.
    The browser can run opacity and transforms off the main thread, so the
    motion stays smooth.
  </p>
  <div slot="stage" class="decks">
    {decks.map(({ name, property, keyframes, cards }) => (
      <Cascade
        class="deck swapped-choice"
        data-choice={name}
        data-selected={name === selected ? "" : undefined}
        keyframes={keyframes}
        duration={900}
        interval={150}
        threshold={0.6}
      >
        {cards.map(({ offset, value }) => (
          <div class="keyframe">
            <span class="offset">{offset}</span>
            <span class="value">
              {property}
              <code>{value}</code>
            </span>
          </div>
        ))}
      </Cascade>
    ))}
  </div>
</Chapter>

<style>
  .decks {
    display: grid;
    width: min(100%, 28rem);
  }

  .deck {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    perspective: 40rem;
  }

  .keyframe {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    aspect-ratio: 3 / 4;
    padding: 0.875rem;
    border-radius: var(--radius-md);
    background-color: var(--pencil);
    color: var(--ink);
  }

  .keyframe:nth-child(2) {
    background-color: var(--marker);
  }

  [data-choice="Flip"] .keyframe {
    transform-origin: 50% 0;
  }

  .offset {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.25rem + 3vw, 3.25rem);
    font-stretch: 85%;
    font-weight: 750;
    line-height: 1;
  }

  .value {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: color-mix(in oklab, var(--ink) 70%, transparent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
  }

  .value code {
    color: var(--ink);
    font-size: inherit;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .keyframe {
      padding: 0.625rem;
    }
  }
</style>
