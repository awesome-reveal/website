---
import type { StartState } from "@awesome-reveal/astro";
import { Reveal } from "@awesome-reveal/astro";
import Chapter from "./Chapter.astro";
import { objectLiteral } from "../../lib/object-literal";

const tiles: { name: string; from: StartState }[] = [
  { name: "Fade", from: { opacity: 0 } },
  { name: "Zoom", from: { opacity: 0, scale: 0.6 } },
  { name: "Swing", from: { opacity: 0, rotate: -12, y: 40 } },
  { name: "Blur", from: { opacity: 0, blur: 12 } },
];
const selected = "Zoom";

const control = {
  name: "from",
  selected,
  options: tiles.map(({ name, from }) => ({
    value: name,
    code: `<Reveal
  from={${objectLiteral(from)}}
>
  <Card />
</Reveal>`,
  })),
};
---

<Chapter
  id="start-states"
  label="Start states"
  title="Zoom, rotate and blur on scroll"
  control={control}
  mark={2}
>
  <p>
    Pass an object to set the start state. Mix opacity, offset, scale, rotation
    and blur. The entrance ends at full opacity and size, with no offset,
    rotation or blur.
  </p>
  <div slot="stage" class="tiles">
    {tiles.map(({ name, from }, index) => (
      <Reveal
        class:list={[
          "tile",
          "outlined-choice",
          { marker: index === 1 || index === 2 },
        ]}
        data-choice={name}
        data-selected={name === selected ? "" : undefined}
        from={from}
        duration={900}
        delay={index * 90}
        threshold={0.6}
      >
        <strong>{name}</strong>
        <code>
          {Object.entries(from).map(([key, value]) => (
            <span>
              {key}: {value}
            </span>
          ))}
        </code>
      </Reveal>
    ))}
  </div>
</Chapter>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    width: min(100%, 28rem);
  }

  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-block-size: 8.5rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  /* Each tile is the only child of its host, so `:nth-child` cannot pick it. */
  .marker {
    background-color: var(--marker);
    color: var(--ink);
  }

  strong {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    font-stretch: 85%;
    line-height: 1;
  }

  .tile code {
    display: flex;
    flex-direction: column;
    font-size: var(--sl-text-xs);
  }
</style>
