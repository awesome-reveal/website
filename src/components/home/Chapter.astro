---
import { Code } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";
import { Cascade, Reveal } from "@awesome-reveal/astro";
import ChoiceControl from "../ChoiceControl.astro";
import ReplayButton from "../ReplayButton.astro";

interface Snippet {
  value: string;
  label?: string;
  code: string;
}

interface Props {
  id: string;
  label: string;
  title: string;
  code?: string;
  control?: { name: string; selected: string; options: Snippet[] };
  mark?: ComponentProps<typeof Code>["mark"];
  replay?: boolean;
}

const {
  id,
  label,
  title,
  code = "",
  control,
  mark,
  replay = true,
} = Astro.props;
const snippets = control?.options ?? [{ value: "", code }];
const selected = control?.selected ?? "";
const hasToolbar = control || replay || Astro.slots.has("controls");
---

<section
  id={id}
  class="chapter not-content"
  data-slide
  data-slide-label={label}
>
  <Cascade class="copy" interval={90} threshold={0.2}>
    <h2 id={`${id}-title`} class="slide-title">
      {title}
    </h2>
    <div class="body slide-lead">
      <slot />
    </div>
  </Cascade>
  <div class="stage" data-markdown-ignore>
    <div class="demo">
      <slot name="stage" />
    </div>
    {hasToolbar && (
      <div class="toolbar">
        {control && (
          <ChoiceControl
            id={id}
            name={control.name}
            selected={selected}
            options={control.options}
          />
        )}
        <slot name="controls" />
        {replay && <ReplayButton class="toolbar-end" title={title} />}
      </div>
    )}
    {replay && (
      <p class="motion-note">
        Your device asks for reduced motion, so the demo shows the content at
        once, with no animation.
      </p>
    )}
  </div>
  <Reveal
    class="code slide-code"
    threshold={0.2}
    delay={150}
    from={{ opacity: 0 }}
  >
    {snippets.map(({ value, code }) => (
      <div
        data-snippet={value}
        hidden={value !== selected}
        data-markdown-ignore={value !== selected ? "" : undefined}
      >
        <Code code={code} lang="jsx" mark={mark} />
      </div>
    ))}
  </Reveal>
</section>

<script>
  import { replayReveals, revealedElementsIn } from "../../lib/replay-reveal";

  // One script runs all the demos, so the page loads no module per chapter.
  for (const chapter of document.querySelectorAll(".chapter")) {
    const stage = chapter.querySelector(".stage")!;
    const snippets = chapter.querySelectorAll<HTMLElement>("[data-snippet]");
    const choices = stage.querySelectorAll<HTMLElement>("[data-choice]");

    chapter.querySelector(".options")?.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const { value } = event.target;
      for (const snippet of snippets) {
        const current = snippet.dataset.snippet === value;
        snippet.hidden = !current;
      }
      for (const choice of choices) {
        const selected = choice.dataset.choice === value;
        choice.toggleAttribute("data-selected", selected);
        if (selected) replayReveals([choice]);
      }
    });

    chapter.querySelector("[data-replay]")?.addEventListener("click", () => {
      // A reveal plays and fires `reveal` also when its element is not displayed.
      // All checks run before the first replay, so the style recalculates only once.
      replayReveals(
        [...revealedElementsIn(stage)].filter((element) =>
          element.checkVisibility(),
        ),
      );
    });
  }
</script>

<style>
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "copy" "stage" "code";
    align-content: center;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  /* The empty rows center the copy and the code beside the stage. */
  @media (min-width: 56rem) {
    .chapter {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: ". stage" "copy stage" "code stage" ". stage";
      gap: 0 var(--space-16);
      padding-block: var(--space-16);
    }

    .chapter:nth-of-type(even) {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-areas: "stage ." "stage copy" "stage code" "stage .";
    }

    .code {
      margin-block-start: var(--space-8);
    }
  }

  .copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .body :global(code) {
    font-size: 0.85em;
  }

  .code {
    grid-area: code;
  }

  .stage {
    grid-area: stage;
    align-self: center;
    container: stage / inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background-color: var(--surface-card);
  }

  .stage :global(.outlined-choice) {
    outline: 3px solid transparent;
    outline-offset: 4px;
    transition: outline-color var(--hover-duration) ease;
  }

  .stage :global(.outlined-choice[data-selected]) {
    outline-color: var(--sl-color-white);
  }

  .stage :global(.swapped-choice:not([data-selected])) {
    display: none;
  }

  .demo {
    display: grid;
    flex: 1;
    place-items: center;
    min-block-size: 15rem;
    padding: var(--space-6) var(--space-5);
  }

  @media (min-width: 56rem) {
    .demo {
      min-block-size: min(22rem, 50svh);
      padding: var(--space-10) var(--space-8);
    }
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-3);
    border-block-start: 1px solid var(--sl-color-hairline-light);
    --option-size: 2.25rem;
    /* The options with their padding and border. */
    --control-size: calc(var(--option-size) + 2 * var(--space-1) + 2px);
  }

  @media (pointer: coarse) {
    .toolbar {
      --option-size: 2.75rem;
    }
  }

  .toolbar-end {
    margin-inline-start: auto;
  }

  /* On a narrow stage, the control and the replay button share one row. */
  @container stage (max-width: 30rem) {
    .toolbar {
      flex-wrap: nowrap;
    }
  }

  .motion-note {
    display: none;
    padding: var(--space-3);
    border-block-start: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-note {
      display: block;
    }
  }
</style>
