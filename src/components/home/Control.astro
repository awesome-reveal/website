---
import { Reveal } from "@awesome-reveal/astro";
import CircleCheck from "@lucide/astro/icons/circle-check";
import Chapter from "./Chapter.astro";

const code = `<Reveal when={saved} hidden={!saved}>
  <Toast>Changes saved</Toast>
</Reveal>`;
---

<Chapter
  id="triggers"
  label="Triggers"
  title="Trigger animations on demand"
  code={code}
  mark="when={saved}"
  replay={false}
>
  <p>
    Not everything waits for a scroll. Set <code>when</code> to{" "}
    <code>true</code> to play the entrance, and to <code>false</code> to reset
    it. Connect it to tabs, steps, toasts or any state you own. Add{" "}
    <code>hidden</code> to hide the content from screen readers too.
  </p>
  <div slot="stage" class="screen">
    <div role="status">
      <Reveal class="toast" when={false} hidden duration={500}>
        <CircleCheck aria-hidden="true" />
        Changes saved
      </Reveal>
    </div>
    <div class="page" aria-hidden="true">
      <span class="line title"></span>
      <span class="line"></span>
      <span class="line"></span>
      <span class="line short"></span>
    </div>
  </div>
  <div slot="controls" class="actions">
    <button type="button" class="save" data-saved="true">
      Save
    </button>
    <button type="button" class="undo" data-saved="false" aria-disabled="true">
      Undo
    </button>
    <code class="state" aria-hidden="true">
      saved = false
    </code>
  </div>
</Chapter>

<script>
  import { getReveal } from "@awesome-reveal/astro";

  const chapter = document.getElementById("triggers");
  const toast = chapter?.querySelector<HTMLElement>(".toast");
  const state = chapter?.querySelector(".actions .state");
  const buttons =
    chapter?.querySelectorAll<HTMLButtonElement>("[data-saved]") ?? [];

  function showToast(saved: boolean) {
    if (!toast) return;
    toast.hidden = !saved;
    getReveal(toast).when = saved;
  }

  function showState(saved: boolean) {
    if (state) state.textContent = `saved = ${saved}`;
    for (const button of buttons) {
      const current = button.dataset.saved === String(saved);
      button.setAttribute("aria-disabled", String(current));
    }
  }

  for (const button of buttons)
    button.addEventListener("click", () => {
      if (button.getAttribute("aria-disabled") === "true") return;
      const saved = button.dataset.saved === "true";
      showToast(saved);
      showState(saved);
    });
</script>

<style>
  .screen {
    position: relative;
    display: grid;
    width: min(100%, 22rem);
    padding: var(--space-6) var(--space-5) var(--space-20);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background-color: var(--sl-color-black);
  }

  .page {
    display: grid;
    gap: var(--space-3);
  }

  .line {
    block-size: 0.6rem;
    border-radius: 999px;
    background-color: var(--sl-color-gray-5);
  }

  .title {
    inline-size: 45%;
    block-size: 1rem;
    margin-block-end: var(--space-2);
    background-color: var(--sl-color-gray-4);
  }

  .short {
    inline-size: 70%;
  }

  /* The transparent border draws the edge of the toast in forced colors. */
  .toast {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background-color: var(--marker);
    color: var(--ink);
    font-weight: 700;

    &[hidden] {
      display: none;
    }
  }

  .actions {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-2);
  }

  button {
    min-block-size: var(--control-size);
    padding: var(--space-2) var(--space-5);
    border-radius: 999px;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color var(--hover-duration) ease,
      color var(--hover-duration) ease;
  }

  .save {
    border: 1px solid transparent;
    background-color: var(--marker);
    color: var(--ink);
    outline-offset: 2px;
  }

  .undo {
    border: 1px solid var(--sl-color-hairline-light);
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    outline-offset: -1px;

    @media (hover: hover) {
      &:not([aria-disabled="true"]):hover {
        border-color: var(--sl-color-text-accent);
        color: var(--sl-color-white);
      }
    }
  }

  /* Not `disabled`: the button keeps the focus, so the keyboard stays on the control. */
  button[aria-disabled="true"] {
    border: 1px dashed var(--sl-color-hairline-light);
    background-color: transparent;
    color: var(--sl-color-gray-3);
    cursor: default;
  }

  .state {
    margin-inline-start: auto;
    padding: 0;
    background: none;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }

  /* Forced colors remove the backgrounds, which are the only shape of the lines. */
  @media (forced-colors: active) {
    .line {
      border: 1px solid CanvasText;
    }
  }
</style>
