---
import { Cascade } from "@awesome-reveal/astro";
import CirclePause from "@lucide/astro/icons/circle-pause";
import EyeOff from "@lucide/astro/icons/eye-off";
import Gauge from "@lucide/astro/icons/gauge";
import Search from "@lucide/astro/icons/search";
---

<section
  id="accessibility-and-seo"
  class="accessibility-and-seo not-content"
  data-slide
  data-slide-label="Accessibility and SEO"
>
  <Cascade class="copy" interval={90} threshold={0.5}>
    <h2 class="slide-title">Accessible and SEO friendly by default</h2>
    <p class="slide-lead">
      Each package does all four with no configuration. You get all of this, and
      a lot more, from a core of less than 2 kB with no dependencies.
    </p>
  </Cascade>
  <Cascade
    as="ul"
    class="points"
    role="list"
    aria-label="Features"
    interval={100}
    threshold={0.2}
  >
    <li>
      <span class="icon">
        <Search />
      </span>
      <h3>SEO friendly</h3>
      <p>
        Search engines and screen readers read all of your content. It is in the
        HTML before any animation plays.
      </p>
    </li>
    <li>
      <span class="icon">
        <EyeOff />
      </span>
      <h3>No flicker on load</h3>
      <p>
        With the React, Vue and Astro packages, content does not blink into view
        before its entrance. If the script fails, it shows after 5 seconds.
      </p>
    </li>
    <li>
      <span class="icon">
        <CirclePause />
      </span>
      <h3>Respects motion settings</h3>
      <p>
        Visitors who ask their device for reduced motion see the content at
        once, with no animation.
      </p>
    </li>
    <li>
      <span class="icon">
        <Gauge />
      </span>
      <h3>Fast and smooth</h3>
      <p>
        Pages stay light, and the motion runs smoothly. The browser does the
        work with its own APIs, so no animation library ships to your visitors.
      </p>
    </li>
  </Cascade>
</section>

<style>
  .accessibility-and-seo {
    display: grid;
    align-content: center;
    gap: var(--space-8);
    padding-block: var(--space-8);
  }

  @media (min-width: 64rem) {
    .accessibility-and-seo {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--space-16);
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  h2 {
    max-width: 18ch;
  }

  .points {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
  }

  .icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-sm);
    background-color: var(--marker);
    color: var(--ink);
    font-size: 1.375rem;
  }

  li:nth-child(even) .icon {
    background-color: var(--pencil);
  }

  @media (min-width: 36rem) {
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    li {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5);
      border: 1px solid var(--sl-color-hairline-light);
      border-radius: var(--radius-md);
      background-color: var(--surface-card);
    }

    .icon {
      margin-block-end: var(--space-3);
    }

    /* In two columns, the colors make a checkerboard. */
    li:nth-child(3) .icon {
      background-color: var(--pencil);
    }

    li:nth-child(4) .icon {
      background-color: var(--marker);
    }
  }

  h3 {
    color: var(--sl-color-white);
    font-size: 1.25rem;
    line-height: 1.15;
  }

  p {
    color: var(--sl-color-gray-3);
  }
</style>
